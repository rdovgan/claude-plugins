# qa-docs workspace settings. Copy to <workspace>/.qa-docs/config.env (owned by the admin, read-only for users).
# KEY=value lines; the plugin parses this file, it never sources it. No secrets here.

# Language of the documents.
QA_DOCS_LANGUAGE=English

# Optional: the repository that holds most business logic, mentioned to the agent first.
QA_DOCS_MAIN_PROJECT=

# Confluence export target. The guard creates pages only in this space under this parent page,
# and updates only pages qa-docs created. Leave empty to keep documents local.
QA_DOCS_CONFLUENCE_CLOUD=<your-site>.atlassian.net
QA_DOCS_CONFLUENCE_SPACE=
QA_DOCS_CONFLUENCE_SPACE_ID=
QA_DOCS_CONFLUENCE_PARENT=

# Sources older than this are reported as stale at session start.
QA_DOCS_STALE_HOURS=48

# A domain lock without writes for this long is released for other sessions.
QA_DOCS_LOCK_MINUTES=120

# mermaid-cli that renders the document diagrams to PNG (kept on the server in qa-docs/domains/*/doc/diagrams/).
# A name on PATH or an absolute path. Without it documents keep the mermaid code only.
QA_DOCS_MMDC=mmdc
# Chrome or Chromium binary mermaid-cli uses (for example /usr/bin/chromium); empty = the one puppeteer installed.
QA_DOCS_CHROME=

# Research budget: sub-flows traced by parallel agents in one run of /qa-docs:document or /qa-docs:refresh.
# Every agent reads code and spends the user's usage limit; more sub-flows are traced only after the user agrees.
QA_DOCS_MAX_SUBFLOWS=6
